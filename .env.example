# Postgres (required at runtime)
DATABASE_URL="postgresql://eduverse:eduverse@localhost:5432/eduverse"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand"
# Public origin of this app (used for cookies + magic-link URLs)
AUTH_URL="http://localhost:8080"

# Optional SMTP for email magic-link sign-in (Nodemailer connection URL)
# Example: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="EduVerse TeleHealth <noreply@vbhealthcare.org>"

# When "true", magic-link API returns the verify URL in the JSON body (local QA only).
# Never enable in production — staff should use SMTP or password sign-in.
MAGIC_LINK_RETURN_URL="false"

# Attachment storage directory (metadata is in Postgres; files stay on disk)
ATTACHMENT_DIR="./data/attachments"

# Reported by /api/version and /api/health for Miss Sparkles
APP_VERSION="1.0.0"
APP_COMMIT=""

# Node
NODE_ENV="development"
PORT="8080"

# First-boot only: docker-compose / App Runner entrypoint may run prisma db seed
SEED_ON_BOOT="false"
